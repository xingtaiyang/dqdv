{
  "name": "projects",
  "version": "1.0.0",
  "description": "Vanilla TypeScript application with Express + Vite (HTML + CSS + TS + Node API)",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "lint:build": "eslint . --quiet",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "excel4node": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "hammerjs": "^2.0.8",
    "html2canvas": "^1.4.1",
    "papaparse": "^5.5.3",
    "xlsx": "^0.18.5",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.20",
    "coze-coding-dev-sdk": "^0.7.17",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "only-allow": "^1.2.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "^7.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.27.2",
      "is-generator-function": "1.0.10"
    }
  }
}
